# ==========================================
# Ghost QA Configuration
# ==========================================

# Application
APP_NAME=Ghost QA
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
DEMO_MODE=false
AUTO_APPROVE=true

# AI provider selection
# AI_PROVIDER: auto | gemini | anthropic | xai | demo
# "auto" precedence: Gemini -> Anthropic -> XAI -> demo fallback
AI_PROVIDER=auto

# Gemini (primary provider - free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (optional fallback)
ANTHROPIC_API_KEY=your_claude_api_key_here

# XAI Grok (optional fallback)
XAI_API_KEY=your_xai_api_key_here

# Database
# For local development, use SQLite:
# DATABASE_URL=sqlite:///./ghost_qa.db
# For production, use PostgreSQL:
DATABASE_URL=postgresql://ghost_qa:ghost_qa_pass@localhost:5432/ghost_qa

# Connection pooling (PostgreSQL only; keep workers × pool_size below PG max_connections)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true

# GitHub
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_API_BASE=https://api.github.com

# UiPath
UIPATH_CLIENT_ID=your_uipath_client_id_here
UIPATH_CLIENT_SECRET=your_uipath_client_secret_here
UIPATH_TENANT_NAME=your_uipath_tenant_name_here
UIPATH_ORG_ID=your_uipath_org_id_here
UIPATH_ENVIRONMENT_ID=your_uipath_environment_id_here
UIPATH_TEST_FOLDER=GhostQA
UIPATH_AUTH_URL=https://cloud.uipath.com/identity/connect/token
UIPATH_TEST_MANAGER_BASE=https://cloud.uipath.com

# Slack (optional)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=ghost-qa-alerts

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# CORS — comma-separated allowed origins (lock down in production)
CORS_ORIGINS=http://localhost:3000

# ==========================================
# Production stack (docker-compose.prod.yml)
# ==========================================
POSTGRES_DB=ghost_qa
POSTGRES_USER=ghost_qa
POSTGRES_PASSWORD=change-me-strong-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
