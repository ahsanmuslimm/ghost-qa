# ==========================================
# Ghost QA Configuration
# ==========================================
# TWO WAYS TO RUN:
#   1) DEMO MODE (default, free, zero credentials) — everything mocked,
#      full pipeline functionality. Just start the server.
#   2) LIVE MODE — set DEMO_MODE=false and fill the credentials you have.
#      Each integration degrades gracefully when its key is absent.
# See README.md → "Run Modes" for the full matrix.

# Application
APP_NAME=Ghost QA
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
DEMO_MODE=true
AUTO_APPROVE=true

# ------------------------------------------
# AI provider (LIVE MODE)
# ------------------------------------------
# AI_PROVIDER: auto | gemini | anthropic | xai | demo
# "auto" precedence: Gemini -> Anthropic -> XAI -> demo fallback
AI_PROVIDER=auto

# Gemini — PRIMARY provider, free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — optional fallback; leave blank if unused
ANTHROPIC_API_KEY=

# XAI Grok — optional fallback; leave blank if unused
XAI_API_KEY=

# ------------------------------------------
# Database
# ------------------------------------------
# Local development (default, zero setup):
DATABASE_URL=sqlite:///./ghost_qa.db
# Production (docker-compose.prod.yml supplies this automatically):
# DATABASE_URL=postgresql://ghost_qa:ghost_qa_pass@localhost:5432/ghost_qa

# Connection pooling (PostgreSQL only; keep workers × pool_size below PG max_connections)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true

# ------------------------------------------
# GitHub (LIVE MODE)
# ------------------------------------------
# PAT with `repo` scope: https://github.com/settings/tokens
GITHUB_TOKEN=
# Any random string; must match the webhook secret in repo Settings → Webhooks
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE=https://api.github.com

# ------------------------------------------
# UiPath Test Cloud (LIVE MODE — OPTIONAL)
# ------------------------------------------
# Execution backend:
#   auto  = UiPath Test Cloud when all credentials below are set, else built-in mock
#   cloud = force UiPath Test Cloud (requires Test Manager license)
#   mock  = always use the built-in executor — recommended on the UiPath FREE
#           plan, which does not include Test Manager ("Service: testmanager
#           not found"). All other integrations stay live.
UIPATH_EXECUTION=auto
# External app credentials: Admin → External Applications (org-scoped OAuth)
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
UIPATH_TENANT_NAME=
UIPATH_ORG_ID=
UIPATH_ENVIRONMENT_ID=
UIPATH_TEST_FOLDER=GhostQA
# Leave empty to auto-build the org-scoped endpoint:
# https://cloud.uipath.com/{UIPATH_ORG_ID}/identity_/connect/token
UIPATH_AUTH_URL=
UIPATH_TEST_MANAGER_BASE=https://cloud.uipath.com
# Space-separated OAuth scopes; must be a subset of the scopes granted to the
# external app in UiPath Admin.
UIPATH_TOKEN_SCOPE=OR.Folders.Read

# ------------------------------------------
# Slack notifications (LIVE MODE — OPTIONAL)
# ------------------------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL=ghost-qa-alerts

# ------------------------------------------
# Security
# ------------------------------------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-secret-key

# CORS — comma-separated allowed origins (lock down in production)
CORS_ORIGINS=http://localhost:3000

# ==========================================
# Production stack (docker-compose.prod.yml)
# ==========================================
POSTGRES_DB=ghost_qa
POSTGRES_USER=ghost_qa
POSTGRES_PASSWORD=change-me-strong-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Shared bearer secret between Alertmanager and the /alertmanager/webhook relay
ALERTMANAGER_WEBHOOK_SECRET=change-me-alertmanager-secret
